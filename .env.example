# Start with synthetic data. Change to public for external market/news queries.
DATA_MODE=demo
SEED_MONEY=100000000
DEFAULT_SYMBOL=005930
REFRESH_MS=1000
FEE_RATE=0.00015
TAX_RATE=0.0020
SLIPPAGE_RATE=0.00005

# Credentials belong in the local API settings dialog, not in this file.
KIS_MODE=real
KIS_ENABLE_WS=true
EXTERNAL_FEATURE_FILE=data/external_features.json

OPENAI_ANALYSIS_ENABLED=false
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_RETRIES=2
OPENAI_STREAM=true
OPENAI_STORE_RESPONSES=false
OPENAI_FIXTURE_MODE=false

NEWS_FIXTURE_MODE=true
NEWS_REFRESH_SECONDS=30
NEWS_MIN_MATERIALITY=65
NEWS_MIN_DATA_QUALITY=60
